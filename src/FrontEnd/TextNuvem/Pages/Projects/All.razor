@page "/Projects"
@using RestSharp
@using TextNuvem.Configuration
@using TextNuvem.Dtos.Customers
@using TextNuvem.Dtos.Projects
@using TextNuvem.Service
@inject AuthService ServiceAuth
@inject NavigationManager Nav
@inject LocalStorageService LocalStorage
@inject IHttpClientFactory Factory

@if (_dashBoard is null)
{
    <span class="spinner-grow"></span>   
    <p class="loading-progress-text">Loading...</p>
}
else
{
    <h1 class="h1 text-center">Projects</h1>

    <div class="card shadow-sm border-0 p-3 ">
        @foreach (var project in _dashBoard.Projects.OrderByDescending(x => x.Favorite))
        {
            <div class="project-item d-flex justify-content-between align-items-center">
                <div>
                    <div class="d-flex align-items-center">
                        <a class="text-black text-project mb-0 cursor-pointer text-decoration-none"
                            href="/Editor/@project.Id"
                           >@project.Name</a>

                        @if (project.Favorite)
                        {
                            <i class="bi cursor-pointer bi-star-fill text-warning ms-2" @onclick="(e) => RemoveFavorite(project.Id)"></i>
                        }
                        else
                        {
                            <i class="bi cursor-pointer bi-star text-mutedms-2" @onclick="(e) => ToFavorite(project.Id)"></i>
                        }

                    </div>

                    <small class="text-muted">
                        @project.LastUpdate.ToString("dd/MM/yyyy")
                    </small>
                </div>

                <div class="buttons-project">
                    <button class="btn btn-danger btn-sm px-5"
                            @onclick="() => ShowRemoveProject(project)">
                        Deletar
                    </button>
                
                    <a class="btn btn-primary btn-sm px-5 text-decoration-none" href="/Editor/@project.Id">Abrir</a>    
                </div>
                
            </div>
        }
    </div>
}

@if (_showRemoveProject)
{
    <div style="left: 50%; transform: translate(-50%, -50%); z-index: 10; " 
         class="dashboard d-flex justify-content-center align-items-center position-relative top-50">
        <div class="card shadow-sm" style="width: 400px; padding: 30px; text-align: center;">

            <h3 class="text-project mb-3">Remover Projeto</h3>

            <p style="color: #555;">
                <strong>@_projectRemove?.Name</strong>
                Tem certeza que deseja deletar este projeto?
                <br>
                <strong>Essa ação não pode ser desfeita.</strong>
            </p>

            <div class="d-flex justify-content-between mt-4">
                <button class="btn btn-light cursor-pointer" style="border-radius: 20px; padding: 10px 20px;" @onclick="CloseRemoveProject">
                    Cancelar
                </button>

                <button class="btn gradient-purple cursor-pointer" style="border-radius: 20px; padding: 10px 20px; color: white;" 
                        @onclick="RemoveProject">
                    Deletar
                </button>
            </div>

        </div>
    </div>
}

@code {
    private CustomerDashBoard? _dashBoard;
    private string _error = string.Empty;
    
    private bool _showRemoveProject = false;
    private ProjectDto? _projectRemove = null;
    
    protected override async Task OnInitializedAsync()
    {
        if (!(await ServiceAuth.CustomerIsAuthentication()))
        {
            LocalStorage.RemoveAuthCustomerFromStorage();
            Nav.NavigateTo("/Customer/Login");
        }

        var expiredToken =await LocalStorage.GetTokenExpired();
        if ( expiredToken is null || expiredToken < DateTime.UtcNow)
        {
            var expiredRefreshToken =   await LocalStorage.GetRefreshTokenExpired();
            if ( expiredRefreshToken is null || expiredRefreshToken < DateTime.UtcNow)
            {
                LocalStorage.RemoveAuthCustomerFromStorage();
                Nav.NavigateTo("/Customer/Login");
            }

            var result = await TryAuthenticationUserRefreshToken();
            if (!result)
            {
                LocalStorage.RemoveAuthCustomerFromStorage();
                Nav.NavigateTo("/Customer/Login");
            }
        }
        
        var id = await LocalStorage.GetCustomerId();
        var client = Factory.CreateClient("Api");

        var response = await client.GetAsync($"{ApiConfiguration.BaseUrl}/Customer/DashBoard?CustomerId={id}");

        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            _error = error;
            return;
        }

        _dashBoard = await response.Content.ReadFromJsonAsync<CustomerDashBoard>();
        _dashBoard?.Projects.OrderBy(x => x.Favorite).Take(15);
    }

    private async Task<bool> TryAuthenticationUserRefreshToken()
    {
        var result = await ServiceAuth.LoginRefreshToken();
        if (!result.IsSuccess)
            return false;

        return true;
    }
    private async Task ToFavorite(Guid id)
    {
        var token =await ServiceAuth.GetToken();
        if(token is null)
        {
            LocalStorage.RemoveAuthCustomerFromStorage();
            Nav.NavigateTo("/Customer/Login");
        }
        
        var client = new RestClient();
        var request = new RestRequest($"{ApiConfiguration.BaseUrl}/Project/SetFavorite")
            .AddJsonBody(new {projectId = id})
            .AddHeader("Authorization",$"Bearer {token}");
        
        var response = await client.PostAsync(request);
        
        _dashBoard?.Projects.First(x => x.Id == id).Favorite = true;
    }

    private async Task RemoveFavorite(Guid id)
    {
        var token =await ServiceAuth.GetToken();
        if(token is null)
        {
            LocalStorage.RemoveAuthCustomerFromStorage();
            Nav.NavigateTo("/Customer/Login");
        }
        
        var client = new RestClient();
        var request = new RestRequest($"{ApiConfiguration.BaseUrl}/Project/RemoveFavorite")
            .AddJsonBody(new {projectId = id})
            .AddHeader("Authorization",$"Bearer {token}");
        
        var response = await client.PostAsync(request);
        
        _dashBoard?.Projects.First(x => x.Id == id).Favorite = false;
    }

    private void ShowRemoveProject(ProjectDto project)
    {
        _showRemoveProject = true;
        _projectRemove = project;
    }
    private void CloseRemoveProject()
    {
        _showRemoveProject = false;
        _projectRemove = null;
    }
    
    private async Task RemoveProject()
    {
        if (_projectRemove is null)
            return;
        
        var token =await ServiceAuth.GetToken();
        var idCustomer =await LocalStorage.GetCustomerId();
        
        if(token is null || idCustomer is null )
        {
            LocalStorage.RemoveAuthCustomerFromStorage();
            Nav.NavigateTo("/Customer/Login");
        }
        
        var client = new RestClient();
        var request = new RestRequest($"{ApiConfiguration.BaseUrl}/Project")
            .AddJsonBody(new {customerId = Guid.Parse(idCustomer!),projectId = _projectRemove.Id })
            .AddHeader("Authorization",$"Bearer {token}");
        
        var response = await client.DeleteAsync(request);
    }

}